rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // admins/{uid} — an empty doc here marks that uid as an admin.
    // Only editable by hand in the Firebase console (nobody can write to it from the app).
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // contracts/{contractId} — one saved overload-contract submission.
    match /contracts/{contractId} {
      // Any signed-in user can create a record, but only as themselves.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;

      // A user can read/update/delete their own records.
      // An admin (listed in /admins) can read/update/delete any record.
            allow read, update, delete: if request.auth != null
                    && (resource.data.ownerUid == request.auth.uid
                        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // users/{uid} — name and username collected at signup.
    // A user can create and read only their own profile doc.
    match /users/{uid} {
    allow read: if true;
    allow create: if request.auth != null && request.auth.uid == uid;
    allow update: if request.auth != null && request.auth.uid == uid;
    allow delete: if request.auth != null
                  && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
  }
  }
}
